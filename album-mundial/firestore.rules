rules_version = '2';

// Reglas de seguridad de Firestore para el Álbum Mundial.
// - Cualquier usuario autenticado puede leer perfiles y stickers (necesario para buscar por código
//   y calcular matches con amigos).
// - Solo cada usuario puede escribir su propio perfil y sus propios stickers.
// - Las amistades son creables por cualquiera de las dos partes y solo legibles por ellas.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read:  if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /stickers/{n} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /friendships/{pairId} {
      allow read:   if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
      allow update: if false;
    }
  }
}
