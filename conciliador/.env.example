# ---------------- Gmail (OAuth) ----------------
# Cuenta a la que se autoriza acceso (debe coincidir con la del consentimiento OAuth).
GMAIL_USER=tu_correo@todomar.com

# Rutas a los archivos OAuth. Por defecto se buscan en la misma carpeta que el script.
# Solo descomenta y cambia si los tienes en otro lado.
#GMAIL_CREDENTIALS_PATH=./credentials.json
#GMAIL_TOKEN_PATH=./token.json

# Filtros (defaults razonables, puedes dejarlos asi)
GMAIL_FROM_FILTER=no-responder@facture.co
GMAIL_SUBJECT_FILTER=TODOMAR CHL
GMAIL_LABEL_PROCESSED=Procesado/Nautiturismo

# ---------------- Rutas locales (Windows) ----------------
SOURCE_EXCEL=G:/Mi unidad/Inteligencia Artificial/Productividad/Gasolina/DETALLE FACTURAS COMBUSTIBLES ENERO A ABRIL 24-2026.xlsx
FACTURAS_DIR=G:/Mi unidad/Inteligencia Artificial/Productividad/Gasolina/Facturas
CONTROL_DIR=G:/Mi unidad/Inteligencia Artificial/Productividad/Gasolina/Control
NO_APLICA_DIR=G:/Mi unidad/Inteligencia Artificial/Productividad/Gasolina/No_Aplica
CONTROL_FILENAME=Control_Conciliacion_Combustibles.xlsx

# ---------------- Conciliacion ----------------
NAUTITURISMO_NIT=901459048
TOLERANCE_PESOS=1000

# ---------------- Claude Vision (opcional) ----------------
# API key de Anthropic para leer remisiones escaneadas (PDFs imagen).
# Si esta vacio, las remisiones escaneadas quedan como "Pendiente revision manual".
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo de Claude para vision (opcional, default Sonnet 4.6 - mas preciso)
# Para mas rapido/barato y menor precision: claude-haiku-4-5-20251001
#ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# ---------------- Rango de fechas (override con --since/--until) ----------------
DATE_FROM=2026-01-01
DATE_TO=2026-04-30
